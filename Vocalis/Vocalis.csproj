<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms serve solo per l'icona nell'area di notifica (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>vocalis.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Evita conflitti di nomi tra WPF e WinForms (Application, MessageBox...):
         WinForms e System.Drawing vanno importati a mano solo dove servono. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

  <!-- I pacchetti Whisper.net.Runtime* copiano le librerie native per TUTTE le piattaforme
       che supportano, non solo win-x64: dopo la pubblicazione togliamo quelle che qui non
       servono mai (~63MB), tenendo solo win-x64 (CPU) e vulkan/win-x64 (GPU). -->
  <Target Name="RimuoviRuntimeNativiInutili" AfterTargets="Publish">
    <ItemGroup>
      <CartelleRuntimeInutili Include="$(PublishDir)runtimes\win-x86" />
      <CartelleRuntimeInutili Include="$(PublishDir)runtimes\win-arm64" />
      <CartelleRuntimeInutili Include="$(PublishDir)runtimes\vulkan\linux-x64" />
    </ItemGroup>
    <RemoveDir Directories="@(CartelleRuntimeInutili)" Condition="Exists('%(CartelleRuntimeInutili.Identity)')" />
  </Target>

</Project>
