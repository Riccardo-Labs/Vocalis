<Window x:Class="Vocalis.UI.FinestraImpostazioni"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vocalis — Impostazioni"
        Width="400" Height="250"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="Attivatore" Margin="0,0,0,4" />
        <TextBox x:Name="CampoAttivatore" Margin="0,0,0,12" />
        <CheckBox x:Name="CampoAvvioConWindows" Content="Avvia con Windows" Margin="0,0,0,16" />
        <Button Content="Salva" Width="80" HorizontalAlignment="Right" Click="Salva_Click" />
    </StackPanel>
</Window>
